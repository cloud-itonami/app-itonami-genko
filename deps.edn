;; kami-genko — 原稿 (genko) manga-editor document-model SSoT (cljc) + JS bridge.
;;
;; genko-embed.ts (kami-engine-sdk の WebGPU pentab エディタ) が持っていた doc/page/node
;; モデル + node-tree ops + oplog(event-sourcing) + serialize を、純 cljc の単一ソースに
;; 切り出したもの (ADR-2607020200 / 2607020300)。tone/fukidashi は kami.mangaka.expression の
;; 語彙を共有し、`page->storyboard` で kami.mangaka.text / analyzeExpression へ橋渡しする。
;;
;; :cljs alias + shadow-cljs.edn で cljc を単一 JS(dist/kami-genko.js)にコンパイルし、
;; globalThis.KamiGenko を生やす → genko-embed.ts の inline JS が委譲する。
;; 純データ/純関数のみ (WebGPU/DOM/B2 は host)。babashka-safe / JVM・cljs・WASM 可搬。
{:paths ["src"]

 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.text"}
       org.clojure/clojure   {:mvn/version "1.12.0"}
        io.github.kotoba-lang/json
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.json"}   ; clj: genko JSON doc の read/write
        ;; shitsuke の kotoba.editor (portable editor kernel: selection/undo/redo/nudge/align)。
        ;; KamiGenko.editor が全ドキュメント snapshot undo/redo に使う (ADR-2607020300 段階1)。zero-dep。
        ;; UI 層は DADS へ移ったが shitsuke は残る —— ここで使うのは
        ;; `kotoba.editor`(portable editor kernel)だけで、HIG skin ではない。
        io.github.kotoba-lang/shitsuke
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.shitsuke"}
        ;; jp-go-digital-design-system — デジタル庁デザインシステム(DADS)の
        ;; cljc hiccup 化。**このワークスペースの基本 design system**
        ;; (オーナー判断 2026-08-05: 実測で DADS 依存 170 repo / kotoba-ui 12 repo)。
        ;; `--hig-*` トークン契約は jp-go-dds.tokens/bridge-css が DADS primitive
        ;; の上に再定義するので、契約で書かれた app CSS は無改造で追従する。
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}
        ;; canvaskit: viewport 数学の正本 (UIScrollView semantics)。genko-render の
        ;; pan/zoom/world<->screen が委譲する (ADR-2607071130。旧 freeboard 移植コピーを差し戻し)。zero-dep。
        ;; murakumo.generation.image — 画像生成 gate の作法(host / 認証の有無 /
        ;; 受理されるサイズ / model map の畳み方 / proxy してはいけない理由)の
        ;; 共有クライアント。genko-app(host wrapper)だけが使う —— genko-view /
        ;; genko-ui はベンダを知らないまま。
        io.github.kotoba-lang/cloud-murakumo-generation
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.cloudMurakumoGeneration"}
        io.github.kotoba-lang/canvaskit
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.canvaskit"}
        ;; kotobase.{client,cacao,cid} — canonical kotobase.net datom-plane client
        ;; (q/datoms/pull/transact + CACAO auth + graph CID), consumed here instead
        ;; of a vendored copy under src/kotobase/ (that vendored copy predated the
        ;; 2026-07-09 apex CACAO shape and 401'd against kotobase.net; removed —
        ;; see kotobase-client README "Why this repo exists"). cljs-only, no JVM
        ;; deps of its own; npm deps (@noble/curves v1, @noble/hashes, @ipld/dag-cbor)
        ;; come from this repo's own package.json (already present).
        io.github.kotoba-lang/kotobase-client
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.kotobaseClient"}
        ;; kotoba-lang/datalog — in-memory Datalog query engine for genko-query
        ;; (ADR-2607091900 / ADR-2608260200 datascript substitution).
        io.github.kotoba-lang/datalog
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.datalog"}}

 :aliases
 {;; Browser bridge: globalThis.KamiGenko を install する単一 JS を出す (reader と同型)。
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs      {:mvn/version "2.28.20"}
                      reagent/reagent           {:mvn/version "1.2.0"}}}

  ;; shadow-cljs :kotobase-test(:node-test) の classpath に cljs-test/ を足すだけの
  ;; alias。cljs 専用構文(cljs.test / npm require)の kotobase-client(git dep)
  ;; smoke test を JVM の kbb -M:test(cognitect.test-runner, test/ を scan)
  ;; から隔離するため test/ とは別ディレクトリに置く。
  :cljs-test {:extra-paths ["cljs-test"]}

  ;; shadow-cljs :genko-query-test(:node-test) の classpath に test/ を足すだけの
  ;; alias (ADR-2607091900 datascript query capability, portability check).
  ;; :test alias 一式(cognitect test-runner + kami-mangaka-expression git dep,
  ;; どちらも JVM 専用/test-only)は要らないので、test/ を挟むだけの最小 alias に
  ;; 分けて kami.mangaka.genko-query-test だけを cljs (node) 上でも確認する。
  :cljs-query-test {:extra-paths ["test"]}

  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                       ;; bridge test が page->storyboard → analyzeExpression 連携を確認するため、
                       ;; kami.mangaka.expression を test-only の git dep で取得 (runtime 依存ではない)。
                       ;; SSoT: kotoba lib/kotoba.kamiMangakaExpression (JUN-649 kept this copy;
                       ;; the duplicate kami-engine packages/kami-mangaka-expression was removed).
                       io.github.kotoba-lang/kami-mangaka-expression
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "64ba9e2e6459e7244ca52945b7b010489d07a008"
         :deps/root "lib/kotoba.kamiMangakaExpression"}}
         :main-opts   ["-m" "cognitect.test-runner"]}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
